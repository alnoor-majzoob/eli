# Production environment for the single-VPS, direct-port deployment.
# Copy to .env.prod, fill in, and never commit .env.prod.
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# Only the web and API ports are public. Restrict them to trusted IPs with the
# VPS firewall/security group; dev auth lets any reachable client choose a role.

# Public IP or hostname of the VPS (no scheme, no trailing slash).
EIL_HOST=203.0.113.10

# Host ports. All service ports stay in the 18000-18100 range.
EIL_WEB_PORT=18080
EIL_API_PORT=18000

# PostgreSQL. Use a strong URL-safe password: no @, :, /, #, or spaces.
POSTGRES_PASSWORD=change-me-url-safe

# Dev auth (APP_ENV=demo + AUTH_MODE=dev).
DEV_JWT_SECRET=change-me-long-random-secret-at-least-32-chars
DEV_JWT_TTL_MINUTES=480

# Monitoring. Bound to 127.0.0.1; reach them through an SSH tunnel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=18030
PROMETHEUS_PORT=18090

# M365 simulator (sim connector mode). API reaches it over Docker network.
M365_SIM_URL=http://m365-sim:9105
M365_SIM_PORT=19105

# Optional extras profile (minio and mailpit).
MINIO_ROOT_USER=eilminio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=18010
MINIO_CONSOLE_PORT=18011
MAILPIT_PORT=18025

# AI (optional).
AI_ENABLED=false
LLM_MODE=replay
GROQ_API_KEY=

# Logging.
LOG_LEVEL=INFO
