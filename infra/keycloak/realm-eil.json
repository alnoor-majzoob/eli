{
  "realm": "eil",
  "enabled": true,
  "displayName": "EIL \u2014 Enterprise Execution Intelligence",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(10) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "executive"
      },
      {
        "name": "portfolio_manager"
      },
      {
        "name": "project_manager"
      },
      {
        "name": "dept_head"
      },
      {
        "name": "resource_manager"
      },
      {
        "name": "team_member"
      },
      {
        "name": "pmo_analyst"
      },
      {
        "name": "ai_reviewer"
      },
      {
        "name": "integration_admin"
      },
      {
        "name": "auditor"
      },
      {
        "name": "admin"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-eil",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "eil"
  },
  "clients": [
    {
      "clientId": "eil-web",
      "name": "EIL Web",
      "description": "EIL SPA (authorization code + PKCE)",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "eil-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "eil-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "eil-org-unit-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-userproperty-mapper",
          "config": {
            "claim.name": "org_unit_id",
            "user.attribute": "org_unit_id",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
