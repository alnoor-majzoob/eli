# =============================================================================
# EIL environment configuration — copy to .env and adjust.
# Defaults below run the platform WITHOUT Docker (SQLite, dev auth, inline jobs).
# For the full stack use infra/compose/docker-compose.yml (see README).
# =============================================================================

# --- Core ---
APP_ENV=local                       # local|ci|demo|staging|prod
APP_NAME=EIL
API_PREFIX=/api/v1
TENANT_TIMEZONE=Asia/Muscat
DEFAULT_LOCALE=en                   # en|ar

# Local fallback (no Docker): SQLite file under the repo .data/ directory.
DATABASE_URL=sqlite+aiosqlite:///./.data/eil.db
# Compose / production:
# DATABASE_URL=postgresql+asyncpg://eil:eil@postgres:5432/eil

# Optional in local mode. Empty => inline outbox dispatcher / eager Celery.
REDIS_URL=
# REDIS_URL=redis://redis:6379/0

# Object storage: local|s3 (s3 backend is implemented in a later phase)
OBJECT_STORE_BACKEND=local
OBJECT_STORE_LOCAL_DIR=./.data/objects
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=eil-artifacts
OBJECT_STORE_ACCESS_KEY=changeme
OBJECT_STORE_SECRET_KEY=changeme

# --- Identity ---
# dev => local demo JWT login. oidc => Keycloak / Entra ID.
AUTH_MODE=dev
DEV_JWT_SECRET=dev-only-not-for-production-change-me-32b
DEV_JWT_TTL_MINUTES=480
OIDC_ISSUER_URL=http://keycloak:8080/realms/eil
# Optional internal discovery URL when the browser-facing issuer differs.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID_WEB=eil-web
OIDC_AUDIENCE=eil-api
REQUIRE_MFA=true
CORS_ORIGINS=["http://localhost:5173"]

# --- Security (plan §13.3, Phase 9, T9.2) ---
# Per-IP rate limiting (hasher bearer tokens also rate-limited per principal).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
# Host allow-list ('*' only in local/ci/demo; required otherwise).
TRUSTED_HOSTS=["*"]

# --- AI / Groq ---
AI_ENABLED=false
AI_EXTRACTION=true
AI_SCORING=true
AI_ASSISTANT=true
LLM_MODE=replay                     # live|replay|record
GROQ_API_KEY=                       # never commit
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_FAST=llama-3.1-8b-instant
MODEL_STRONG=llama-3.3-70b-versatile
MODEL_STRONG_FALLBACK=openai/gpt-oss-120b
MODEL_STT=whisper-large-v3-turbo
LLM_RPM_FAST=30
LLM_TPM_FAST=6000
LLM_RPM_STRONG=30
LLM_TPM_STRONG=6000
LLM_MAX_RETRIES=5
LLM_CACHE_TTL_SECONDS=86400
REPLAY_CASSETTE_DIR=./seed/cassettes

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Connectors (sim|live per system) ---
CONNECTOR_MODE_M365=sim
CONNECTOR_MODE_P6=sim
CONNECTOR_MODE_EAM=sim
CONNECTOR_MODE_ERP=sim
CONNECTOR_MODE_HR=sim
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Engines ---
MC_ITERATIONS=10000
MC_SEED=42
CAPACITY_AMBER=0.85
CAPACITY_RED=1.00
CONFIDENCE_GREEN=0.80
CONFIDENCE_AMBER=0.50

# --- Notifications ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=eil@example.invalid

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Realtime / demo ---
SSE_ENABLED=true
OUTBOX_INLINE_DISPATCHER=true

# --- Web (Vite reads these from the repository root) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=eil-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
